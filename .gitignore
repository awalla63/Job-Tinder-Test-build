# Data — never commit the corpora
data/raw/
*.csv
*.csv.zip
*.parquet

# Model artifacts -- track the three files ml/train.py produces (small, ~3.5MB total,
# and the deployed backend needs them: no training step runs at deploy time, it just
# ships the already-trained, already-gated model from the repo) but ignore anything
# else that lands here (e.g. ad-hoc checkpoints from experimentation).
models/*
!models/fit_model.txt
!models/fit_artifacts.joblib
!models/metrics.json
*.txt.model
*.onnx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node
node_modules/
dist/
.vite/

# Env
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# TS build artifact
*.tsbuildinfo
