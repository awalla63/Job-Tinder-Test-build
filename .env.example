# ---- Supabase ----
# Project ref is the subdomain of your Supabase URL: https://<ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

# Service role key: bypasses RLS. BACKEND ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (used by the bulk loaders in data/)
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---- USAJOBS ----
# Key from https://developer.usajobs.gov/apirequest/
# USAJOBS_USER_AGENT must be the email address you registered with.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# ---- Local data paths (loaders) ----
POSTINGS_CSV=C:/Users/andre/Downloads/postings.csv.zip
RESUMES_CSV=C:/Users/andre/Downloads/Resume.csv.zip

# ---- Model ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FIT_MODEL_PATH=models/fit_model.txt

# ---- Frontend (apps/web/.env.local) ----
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=http://localhost:8000
